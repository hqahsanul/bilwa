{
  "name": "bilwa-marketing-site",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prune-assets": "node scripts/prune-bilva-public-assets.mjs",
    "start-all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops.ps1 start-all",
    "restart-all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops.ps1 restart-all",
    "stop-all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops.ps1 stop-all",
    "build-all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops.ps1 build-all",
    "start-app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops.ps1 start-app",
    "restart-app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops.ps1 restart-app",
    "start-nginx": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops.ps1 start-nginx",
    "restart-nginx": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops.ps1 restart-nginx",
    "docker:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops.ps1 logs"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "^15.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  }
}