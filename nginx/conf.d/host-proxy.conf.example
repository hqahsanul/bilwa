# Copy to host nginx (not Docker) when the app runs on localhost:3000:
#   cp nginx/conf.d/host-proxy.conf.example /etc/nginx/sites-available/bilwa
#   ln -s /etc/nginx/sites-available/bilwa /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# Or with docker-compose.app.yml: upstream points at 127.0.0.1:3000

upstream bilwa_nextjs_host {
    server 127.0.0.1:3000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name sribilva.com www.sribilva.com;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://bilwa_nextjs_host;
    }
}